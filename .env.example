# GitHub (used by code-local and code-gitlab backups)
GITHUB_TOKEN=""
GITHUB_USERNAME=""
USE_GITHUB_SSH="false"

# GitLab (used by code-gitlab backup)
GITLAB_TOKEN=""
GITLAB_NAMESPACE=""
AUTO_CREATE_GITLAB_PROJECTS="true"
GITLAB_VISIBILITY="private"
GITLAB_HOST="https://gitlab.com"
BACKUP_ROOT="$HOME/GitHub-GitLab-Backup"

# Google (used by google-calendar, google-tasks, and google-contacts backups)
# OAuth 2.0 credentials for an installed/desktop app. The refresh token is
# obtained automatically via a one-time browser authorization the first time
# you run any Google backup interactively, and is saved back to this file.
# backup:all skips the Google steps as SKIPPED (no credentials) until it is
# saved.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_SHOW_DELETED="false"
GOOGLE_TASKS_SHOW_COMPLETED="true"
GOOGLE_TASKS_SHOW_DELETED="true"
GOOGLE_TASKS_SHOW_HIDDEN="true"

# Google Photos (used by google-photos Takeout backup)
# After requesting an export at takeout.google.com, paste the download links
# from your "Your Google data is ready" email here, comma-separated, e.g.:
# GOOGLE_PHOTOS_TAKEOUT_URLS="https://takeout.googleapis.com/...,https://takeout.googleapis.com/..."
GOOGLE_PHOTOS_TAKEOUT_URLS=""
# Directories for the Takeout backup pipeline: where archive slices are
# downloaded and where the deduplicated photo library is built.
GOOGLE_PHOTOS_SLICES_DIR=""
GOOGLE_PHOTOS_TARGET_DIR=""

# Notion (used by notion backup)
NOTION_API_TOKEN=""

# Spotify (used by spotify backup; deprecated and disabled in backups.json)
# OAuth 2.0 credentials for an app created at
# developer.spotify.com/dashboard. The refresh token is obtained via a
# one-time browser authorization (npm run auth:spotify or
# ./spotify/spotify-auth.sh) and saved back to this file. A refresh token
# can rot while the module sits disabled; re-run the auth helper when
# enabling the step.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REFRESH_TOKEN=""
# Optional tuning
PLAYLIST_LIMIT="50"
TRACK_LIMIT="100"

# Todoist (used by todoist backup; deprecated and disabled in backups.json)
# API token from Todoist Settings -> Integrations -> Developer.
TODOIST_API_TOKEN=""

# Export archives (used by all export-producing backups, including the
# bookmarks HTML/JSON exports)
# Local export root for dated Exports_* directories. Absolute or
# ~-relative; defaults to ~/Exports when unset.
EXPORTS_DIR=""
# Volume label of an external drive to copy export files to (e.g. "T7 Shield").
# When unset, the external copy is skipped with an informational log.
EXTERNAL_DRIVE_LABEL=""
# Subpath on the external drive under which dated Exports_* directories are
# created. Defaults to "Exports"; ignored when EXTERNAL_DRIVE_LABEL is unset.
EXTERNAL_DRIVE_EXPORT_SUBPATH=""

# Orchestrator (used by npm run status)
# Age of the last fully successful run, in hours, beyond which `npm run
# status` warns that backups may have stopped running. Default: 26 (one
# daily cron pass with slack).
BACKUP_STALENESS_HOURS=""
