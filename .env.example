# GitHub (used by code-local and code-gitlab backups)
GITHUB_TOKEN=""
GITHUB_USERNAME=""
USE_GITHUB_SSH="false"

# GitLab (used by code-gitlab backup)
GITLAB_TOKEN=""
GITLAB_NAMESPACE=""
AUTO_CREATE_GITLAB_PROJECTS="true"
GITLAB_VISIBILITY="private"
GITLAB_HOST="https://gitlab.com"
BACKUP_ROOT="$HOME/GitHub-GitLab-Backup"

# Google (used by google-calendar, google-tasks, and google-contacts backups)
# OAuth 2.0 credentials for an installed/desktop app. The refresh token is
# obtained automatically via a one-time browser authorization the first time
# you run any Google backup, and is saved back to this file.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_SHOW_DELETED="false"
GOOGLE_TASKS_SHOW_COMPLETED="true"
GOOGLE_TASKS_SHOW_DELETED="true"
GOOGLE_TASKS_SHOW_HIDDEN="true"

# Google Photos (used by google-photos Takeout backup)
# After requesting an export at takeout.google.com, paste the download links
# from your "Your Google data is ready" email here, comma-separated, e.g.:
# GOOGLE_PHOTOS_TAKEOUT_URLS="https://takeout.googleapis.com/...,https://takeout.googleapis.com/..."
GOOGLE_PHOTOS_TAKEOUT_URLS=""
# Directories for the Takeout backup pipeline: where archive slices are
# downloaded and where the deduplicated photo library is built.
GOOGLE_PHOTOS_SLICES_DIR=""
GOOGLE_PHOTOS_TARGET_DIR=""

# Notion (used by notion backup)
NOTION_API_TOKEN=""
